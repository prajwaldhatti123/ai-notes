---
// Site-wide navigation: main pages, then every note grouped by track.
// The track holding the current page starts open.
import { tracks, noteHref } from '../data/roadmap';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
const activeTrack = tracks.find((t) => path.startsWith(`/ai/notes/${t.id}/`))?.id ?? tracks[0].id;
const main = [
  { href: '/', label: 'All notebooks' },
  { href: '/ai/', label: 'AI home' },
  { href: '/ai/notes/', label: 'All notes' },
  { href: '/ai/roadmap/', label: 'Roadmap' },
  { href: '/ai/practice/', label: 'Practice' },
  { href: '/ai/projects/', label: 'Projects' },
  { href: '/ai/numpy/', label: 'NumPy reference' },
  { href: '/ai/sklearn/', label: 'scikit-learn reference' },
  { href: '/ai/python/', label: 'Python tools reference' },
  { href: '/ai/glossary/', label: 'Glossary' },
];
---

<aside id="sidebar" class="sidebar" aria-label="Notes navigation">
  <div class="sidebar-main">
    {main.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
  </div>
  {
    tracks.map((track) => (
      <details open={track.id === activeTrack}>
        <summary>
          <b>{track.number}</b>
          <span>{track.title}</span>
        </summary>
        <ol>
          {track.notes.map((note) => (
            <li>
              {note.ready ? (
                <a href={noteHref(track, note)} aria-current={current(noteHref(track, note))}>
                  {note.title}
                </a>
              ) : (
                <span class="pending" title="Not written yet">
                  {note.title} <small>soon</small>
                </span>
              )}
            </li>
          ))}
        </ol>
      </details>
    ))
  }
</aside>
