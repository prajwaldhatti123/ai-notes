---
// Syntax-highlighted code with a light and a dark theme; global.css switches between them.
// Names in the code become links to the reference pages:
//   NumPy (np.log, rng.normal, .reshape, @, ...)            -> /ai/numpy/
//   scikit-learn (LinearRegression, .fit, train_test_split) -> /ai/sklearn/
//   Python tools (zip, sorted, lambda, plt.plot, pd.DataFrame) -> /ai/python/
import { codeToHtml } from 'shiki';
import { numpyLinks } from '../data/numpy';
import { sklearnLinks } from '../data/sklearn';
import { pyLinks } from '../data/pytools';

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = 'python' } = Astro.props;

const targets: Record<string, string> = {};
for (const [k, id] of Object.entries(pyLinks)) targets[k] = `/ai/python/#${id}`;
for (const [k, id] of Object.entries(sklearnLinks)) targets[k] = `/ai/sklearn/#${id}`;
for (const [k, id] of Object.entries(numpyLinks)) targets[k] = `/ai/numpy/#${id}`;

const escape = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const keys = Object.keys(targets).sort((a, b) => b.length - a.length);
const pattern = new RegExp(keys.map(escape).join('|'), 'g');
const ident = /[A-Za-z0-9_]/;
// Names used without a call: array attributes, fitted attributes, pandas .loc[...]
const attributes = new Set(['.shape', '.ndim', '.size', '.dtype', '.T', '.coef_', '.intercept_', '.named_steps', '.loc']);
// Built-in functions only count when called, so the word "zip" in a comment is left alone.
const calledOnly = new Set(['zip', 'enumerate', 'sorted']);

const decorations: { start: number; end: number; tagName: string; properties: Record<string, string> }[] = [];
if (lang === 'python') {
  for (const m of code.matchAll(pattern)) {
    const key = m[0];
    const start = m.index!;
    const end = start + key.length;
    const before = code[start - 1] ?? '';
    const after = code[end] ?? '';
    if (key === '@') {
      if (before !== ' ' || after !== ' ') continue;
    } else if (key.startsWith('[')) {
      // "[:, None]" is matched literally.
    } else if (key.startsWith('.')) {
      // A method or attribute: must follow a name or a closing bracket,
      // and must be called (methods) or stand alone (attributes).
      if (!(ident.test(before) || before === ')' || before === ']')) continue;
      if (ident.test(after)) continue;
      if (!attributes.has(key) && after !== '(') continue;
    } else {
      // np.*, plt.*, pd.*, class and function names: whole names only, not part of a longer dotted name.
      if (ident.test(before) || before === '.' || ident.test(after)) continue;
      if (calledOnly.has(key) && after !== '(') continue;
    }
    // Overlapping matches cannot happen: matchAll moves past each match.
    decorations.push({ start, end, tagName: 'a', properties: { href: targets[key], class: 'np' } });
  }
}

let html = await codeToHtml(code, {
  lang: lang as any,
  themes: { light: 'vitesse-light', dark: 'vitesse-dark' },
  decorations,
});
html = html.replace('<pre class="shiki ', '<pre class="astro-code shiki ').replace('tabindex="0"', `tabindex="0" data-language="${lang}"`);
---

<Fragment set:html={html} />
