---
// The boxed blocks used in every note. `say` is the short interview line placed inside a section;
// `interview` is the full spoken answer near the end. `kind` picks the colour and the default label.
interface Props {
  kind: 'plain' | 'say' | 'interview' | 'pitfall' | 'revision' | 'note';
  label?: string;
}

const defaults = {
  plain: 'In plain words',
  say: 'Say this in the interview',
  interview: 'The full interview answer',
  pitfall: 'Common mistake',
  revision: 'One-minute revision',
  note: 'Note',
};

const { kind, label = defaults[kind] } = Astro.props;
---

<aside class={`callout ${kind}`}>
  <span class="callout-label">{label}</span>
  <slot />
</aside>
