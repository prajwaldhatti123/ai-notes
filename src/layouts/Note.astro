---
import Base from './Base.astro';
import { tracks, noteHref, readingOrder } from '../data/roadmap';

interface Props {
  track: string;
  slug: string;
  lede: string;
  sections: { id: string; label: string }[];
}

const { track: trackId, slug, lede, sections } = Astro.props;

// Previous and next follow the reading order (math and ML interleaved), not the track list.
const flat = readingOrder;
const index = flat.findIndex((e) => e.track.id === trackId && e.note.slug === slug);
if (index === -1) throw new Error(`Note ${trackId}/${slug} is not listed in src/data/roadmap.ts`);

const { track, note } = flat[index];
const position = track.notes.indexOf(note) + 1;
const prev = flat.slice(0, index).findLast((e) => e.note.ready);
const next = flat.slice(index + 1).find((e) => e.note.ready);
---

<Base title={note.title} description={lede}>
  <div class="note-layout">
    <article class="prose">
      <p class="eyebrow">
        {track.short} · Week {note.week} · Note {position} of {track.notes.length}
      </p>
      <h1>{note.title}</h1>
      <p class="lede">{lede}</p>

      <slot />

      <nav class="note-pager" aria-label="Notes">
        <span>{prev && <a href={noteHref(prev.track, prev.note)}>← {prev.note.title}</a>}</span>
        <span>{next && <a href={noteHref(next.track, next.note)}>{next.note.title} →</a>}</span>
      </nav>
    </article>

    <aside class="note-toc" aria-label="On this page">
      <strong>On this page</strong>
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </aside>
  </div>
</Base>
