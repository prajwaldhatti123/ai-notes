---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Interview-ready notes for AI engineering, explained simply and precisely.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/notes/', label: 'Notes' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/projects/', label: 'Projects' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · AI Engineer Notes</title>
    <!-- Runs before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <!-- Shared filter that gives diagram shapes a hand-drawn wobble. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" style="fill: var(--ink)"></path>
        </marker>
      </defs>
      <!-- userSpaceOnUse so straight lines (zero-height boxes) are not clipped away. -->
      <filter id="sketch" filterUnits="userSpaceOnUse" x="-50" y="-50" width="2000" height="2000">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5"></feDisplacementMap>
      </filter>
    </svg>

    <header class="site-header">
      <button class="icon-btn menu-btn" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="site-title" href="/">AI Engineer Notes</a>
      <nav class="top-links" aria-label="Main">
        {
          links.map((l) => (
            <a class="nav-link" href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <button class="icon-btn theme-btn" type="button" aria-label="Switch between light and dark mode">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
      </button>
    </header>

    <div class="backdrop"></div>
    <Sidebar />

    <div class="site-main">
      <main class="page">
        <slot />
      </main>
      <footer class="site-footer">Simple first, precise second, spoken out loud third.</footer>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var menu = document.querySelector('.menu-btn');

        document.querySelector('.theme-btn').addEventListener('click', function () {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });

        function setNav(open) {
          if (open) root.dataset.navOpen = '';
          else delete root.dataset.navOpen;
          menu.setAttribute('aria-expanded', String(open));
        }
        menu.addEventListener('click', function () {
          setNav(!('navOpen' in root.dataset));
        });
        document.querySelector('.backdrop').addEventListener('click', function () {
          setNav(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setNav(false);
        });

        // Keep the current note visible in the sidebar's own scroll area.
        var active = document.querySelector('.sidebar [aria-current]');
        var sidebar = document.getElementById('sidebar');
        if (active) sidebar.scrollTop = active.offsetTop - sidebar.clientHeight / 2;
      })();
    </script>
  </body>
</html>
