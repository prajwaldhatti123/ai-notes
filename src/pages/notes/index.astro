---
import Base from '../../layouts/Base.astro';
import TrackNotes from '../../components/TrackNotes.astro';
import { tracks, totalNotes } from '../../data/roadmap';

const ready = tracks.flatMap((t) => t.notes).filter((n) => n.ready).length;
---

<Base title="Notes">
  <div class="prose">
    <p class="eyebrow">{ready} of {totalNotes} written</p>
    <h1>Notes</h1>
    <p class="lede">
      Every note by subject. Math and ML are studied together in weeks 1–4; the week badge tells you which notes go
      together, and the <a href="/roadmap/">roadmap</a> gives the exact reading order.
    </p>
    <p>
      Two reference pages support every note: the <a href="/glossary/">glossary</a> (one plain sentence per technical
      word, linked from the notes wherever a word appears before the note that teaches it) and the
      <a href="/numpy/">NumPy reference</a> (one entry per function used in the code, linked from every code block).
    </p>
    {
      tracks.map((track) => (
        <section class="phase" id={track.id}>
          <div class="phase-head">
            <span class="phase-number">{track.number}</span>
            <h2>{track.title}</h2>
            <span class="phase-weeks">{track.weeks}</span>
          </div>
          <p>{track.scope}</p>
          <TrackNotes track={track} />
        </section>
      ))
    }
  </div>
</Base>
