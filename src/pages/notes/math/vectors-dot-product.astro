// Plotting helpers: a panel maps math coordinates to SVG coordinates.
const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;
const axes = (p: Panel) => `M${p.x} ${sy(p, 0).toFixed(1)} H${p.x + p.w} M${sx(p, 0).toFixed(1)} ${p.y} V${p.y + p.h}`;
const arrow = (p: Panel, from: [number, number], to: [number, number]) =>
  `M${sx(p, from[0]).toFixed(1)} ${sy(p, from[1]).toFixed(1)} L${sx(p, to[0]).toFixed(1)} ${sy(p, to[1]).toFixed(1)}`;
const grid = (p: Panel) => {
  const parts: string[] = [];
  for (let i = M.ceil(p.xr[0]); i <= p.xr[1]; i++) parts.push(`M${sx(p, i).toFixed(1)} ${p.y} V${p.y + p.h}`);
  for (let j = M.ceil(p.yr[0]); j <= p.yr[1]; j++) parts.push(`M${p.x} ${sy(p, j).toFixed(1)} H${p.x + p.w}`);
  return parts.join(' ');
};

// Fig. 1: one vector as an arrow with its components.
const one: Panel = { x: 80, y: 30, w: 300, h: 225, xr: [-1, 4], yr: [-1, 3] };
// Fig. 2: addition and scaling.
const add: Panel = { x: 40, y: 30, w: 300, h: 250, xr: [-1, 5], yr: [-1, 5] };
const scale: Panel = { x: 400, y: 30, w: 300, h: 250, xr: [-1, 5], yr: [-1, 5] };
// Fig. 3: three dot-product signs.
const signs = [
  { x: 40, a: [2, 1] as [number, number], b: [3, 2] as [number, number], label: 'a·b = 8 > 0', sub: 'same general direction' },
  { x: 270, a: [2, 1] as [number, number], b: [-1, 2] as [number, number], label: 'a·b = 0', sub: 'perpendicular' },
  { x: 500, a: [2, 1] as [number, number], b: [-2, -1] as [number, number], label: 'a·b = −5 < 0', sub: 'opposite directions' },
].map((s) => ({ ...s, panel: { x: s.x, y: 40, w: 190, h: 190, xr: [-3, 3] as [number, number], yr: [-3, 3] as [number, number] } }));
// Fig. 4: projection of a onto b.
const proj: Panel = { x: 80, y: 30, w: 330, h: 260, xr: [-0.5, 5], yr: [-0.5, 4.5] };
const projA: [number, number] = [3, 4];
const projB: [number, number] = [4, 3];
const projLen = (3 * 4 + 4 * 3) / 5; // 4.8
const projPoint: [number, number] = [(projLen * 4) / 5, (projLen * 3) / 5];
// Fig. 5: toy word vectors.
const words: Panel = { x: 90, y: 30, w: 420, h: 250, xr: [0, 1.1], yr: [0, 1.1] };
const wordVecs = [
  { w: 'cat', v: [0.9, 0.3] as [number, number] },
  { w: 'dog', v: [0.8, 0.45] as [number, number] },
  { w: 'kitten', v: [0.95, 0.2] as [number, number] },
  { w: 'car', v: [0.2, 0.9] as [number, number] },
  { w: 'truck', v: [0.3, 0.95] as [number, number] },
];

const basicsCode = `import numpy as np

x = np.array([3.0, 2.0])          # a vector: a 1-D array
print(x.shape)                    # (2,)   <- one number in the shape = one axis = a vector
print(x.ndim)                     # 1

u = np.array([2.0, 1.0])
v = np.array([1.0, 3.0])
print(u + v)                      # [3. 4.]   component by component
print(2 * v)                      # [2. 6.]   every component doubled
print(3 * u - v)                  # [5. 0.]   a linear combination

w = np.array([3.0, -2.0, -4.0])   # the walk neuron's weights
inputs = np.array([1.0, 0.0, 1.0])  # sunny, not cold, tired
print(w * inputs)                 # [ 3. -0. -4.]  element-wise product: still a vector
print(np.sum(w * inputs))         # -1.0          add it up: that is the dot product
print(np.dot(w, inputs), w @ inputs)   # -1.0 -1.0   the two built-in spellings`;

const dotCode = `import numpy as np

def dot(a, b):
    """The definition, spelled out."""
    assert a.shape == b.shape, f"shapes differ: {a.shape} vs {b.shape}"
    total = 0.0
    for ai, bi in zip(a, b):
        total += ai * bi
    return total

a = np.array([3.0, 4.0])
b = np.array([4.0, 3.0])
assert dot(a, b) == np.dot(a, b) == a @ b == 24.0

length_a = np.sqrt(a @ a)                 # 5.0: the length is the square root of the self dot product
length_b = np.linalg.norm(b)              # 5.0: the library way
cos_theta = (a @ b) / (length_a * length_b)
print(cos_theta)                          # 0.96
print(np.degrees(np.arccos(cos_theta)))   # 16.26 degrees

# The shadow (projection) of a onto the direction of b:
print((a @ b) / length_b)                 # 4.8`;

const embedCode = `import numpy as np

# Toy "embeddings": one vector per word. Real ones have hundreds of numbers; the arithmetic is identical.
emb = {
    "cat":    np.array([0.9, 0.8, 0.1]),
    "dog":    np.array([0.8, 0.9, 0.2]),
    "car":    np.array([0.1, 0.2, 0.9]),
}

def similarity(w1, w2):
    return emb[w1] @ emb[w2]

print(similarity("cat", "dog"))   # 1.46  high: the lists agree
print(similarity("cat", "car"))   # 0.34  low: where one is big the other is small

# Find the nearest word to a query vector: compute every dot product, take the largest.
query = np.array([0.85, 0.85, 0.15])
scores = {w: v @ query for w, v in emb.items()}
print(max(scores, key=scores.get))   # dog  (scores: cat 1.46, dog 1.475, car 0.39)`;

const matrixPreviewCode = `import numpy as np

W = np.array([[3.0, -2.0, -4.0],     # neuron 1: the walk neuron
              [1.0, -1.0,  0.0]])    # neuron 2: "is the weather good?"
x = np.array([1.0, 0.0, 1.0])

print(W @ x)          # [-1.  1.]   two dot products, one per row, in a single operation
print(W.shape, x.shape, (W @ x).shape)   # (2, 3) (3,) (2,)`;
