const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;
const axes = (p: Panel) => `M${p.x} ${sy(p, 0).toFixed(1)} H${p.x + p.w} M${sx(p, 0).toFixed(1)} ${p.y} V${p.y + p.h}`;
const arrow = (p: Panel, from: [number, number], to: [number, number]) =>
  `M${sx(p, from[0]).toFixed(1)} ${sy(p, from[1]).toFixed(1)} L${sx(p, to[0]).toFixed(1)} ${sy(p, to[1]).toFixed(1)}`;
const poly = (p: Panel, pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${sx(p, a).toFixed(1)} ${sy(p, b).toFixed(1)}`).join(' ') + ' Z';
const curve = (p: Panel, f: (x: number) => number, n = 160) =>
  Array.from({ length: n + 1 }, (_, i) => {
    const vx = p.xr[0] + ((p.xr[1] - p.xr[0]) * i) / n;
    return `${i ? 'L' : 'M'}${sx(p, vx).toFixed(1)} ${sy(p, f(vx)).toFixed(1)}`;
  }).join(' ');

// Fig. 1: the unit "circles" of three norms.
const balls: Panel = { x: 210, y: 20, w: 240, h: 240, xr: [-1.5, 1.5], yr: [-1.5, 1.5] };
const circle = Array.from({ length: 73 }, (_, i) => [M.cos((i * M.PI) / 36), M.sin((i * M.PI) / 36)] as [number, number]);
// Fig. 2: Euclidean vs Manhattan.
const dist: Panel = { x: 80, y: 30, w: 300, h: 250, xr: [0, 5], yr: [0, 7] };
// Fig. 3: cosine vs distance.
const cosP: Panel = { x: 80, y: 30, w: 300, h: 260, xr: [-0.3, 3], yr: [-0.3, 4.5] };
// Fig. 4: three metrics, three rankings.
const rank: Panel = { x: 70, y: 30, w: 300, h: 260, xr: [-0.3, 4.6], yr: [-0.3, 4.6] };
const docs = [
  { name: 'q', v: [1, 1] as [number, number], red: true },
  { name: 'd₁', v: [4, 4] as [number, number], red: false },
  { name: 'd₂', v: [0.8, 1.2] as [number, number], red: false },
  { name: 'd₃', v: [3, 0.3] as [number, number], red: false },
];
// Fig. 5: cosine between random vectors concentrates near 0 as d grows.
const conc: Panel = { x: 80, y: 30, w: 560, h: 220, xr: [-1, 1], yr: [0, 1.1] };
const bump = (s: number) => (x: number) => M.exp(-(x * x) / (2 * s * s));
const spreads = [
  { d: 3, s: 0.5, label: 'd = 3' },
  { d: 30, s: 0.18, label: 'd = 30' },
  { d: 768, s: 0.036, label: 'd = 768' },
];

const normsCode = `import numpy as np

v = np.array([3.0, -4.0])
print(np.linalg.norm(v))             # 5.0   L2 (default): sqrt(9 + 16)
print(np.linalg.norm(v, ord=1))      # 7.0   L1: |3| + |-4|
print(np.linalg.norm(v, ord=np.inf)) # 4.0   L-infinity: the largest |component|
print(np.sqrt(v @ v))                # 5.0   the L2 norm is the square root of the self dot product

a, b = np.array([1.0, 2.0]), np.array([4.0, 6.0])
print(np.linalg.norm(a - b))         # 5.0   Euclidean distance: the norm of the difference
print(np.abs(a - b).sum())           # 7.0   Manhattan distance

def cosine(a, b):
    return (a @ b) / (np.linalg.norm(a) * np.linalg.norm(b))

print(cosine(np.array([1.0, 2.0]), np.array([2.0, 4.0])))   # 1.0   same direction, different length
print(cosine(np.array([1.0, 2.0]), np.array([2.0, 1.0])))   # 0.8
print(cosine(np.array([1.0, 2.0]), np.array([-2.0, 1.0])))  # 0.0   orthogonal
print(cosine(np.array([1.0, 2.0]), np.array([-1.0, -2.0]))) # -1.0  opposite`;

const rankingCode = `import numpy as np

q = np.array([1.0, 1.0])
D = np.array([[4.0, 4.0],      # d1: same direction as q, four times as long
              [0.8, 1.2],      # d2: very close to q as a point
              [3.0, 0.3]])     # d3: long, pointing elsewhere

dot = D @ q
cos = dot / (np.linalg.norm(D, axis=1) * np.linalg.norm(q))
euc = np.linalg.norm(D - q, axis=1)

for name, scores, best_is in [("dot", dot, "largest"), ("cosine", cos, "largest"), ("euclidean", euc, "smallest")]:
    order = np.argsort(-scores) if best_is == "largest" else np.argsort(scores)
    print(f"{name:>9}: {np.round(scores, 2)}  ranking: {['d'+str(i+1) for i in order]}")
#       dot: [8.   2.   3.3 ]  ranking: ['d1', 'd3', 'd2']
#    cosine: [1.   0.98 0.77]  ranking: ['d1', 'd2', 'd3']
# euclidean: [4.24 0.28 2.12]  ranking: ['d2', 'd3', 'd1']

# Normalize everything to unit length and the three metrics agree:
Dn = D / np.linalg.norm(D, axis=1, keepdims=True)
qn = q / np.linalg.norm(q)
print(np.argsort(-(Dn @ qn)), np.argsort(np.linalg.norm(Dn - qn, axis=1)))   # same order`;

const libraryCode = `import numpy as np

E = np.random.default_rng(0).normal(size=(5, 8))      # five "embeddings", one per row

# Every pairwise cosine similarity in two lines: normalize the rows, then one matrix product.
En = E / np.linalg.norm(E, axis=1, keepdims=True)     # (5, 8) / (5, 1): each row now has length 1
S = En @ En.T                                         # (5, 5): cosine = dot product of unit vectors
print(np.round(S, 2))
print(np.allclose(np.diag(S), 1.0))                   # every vector has cosine 1 with itself

# Capping the length of a vector: "if it is longer than 1, shrink it to length 1, keep its direction".
v = np.array([3.0, 4.0, 12.0])                        # length 13
cap = 1.0
scale = min(1.0, cap / np.linalg.norm(v))
v_capped = v * scale
print(v_capped, np.linalg.norm(v_capped))             # [0.231 0.308 0.923] 1.0
# Training code does exactly this to the update step every iteration; week 6 calls it gradient clipping.`;

const concentrationCode = `import numpy as np

rng = np.random.default_rng(0)
for d in [3, 30, 300, 768]:
    A = rng.normal(size=(5000, d))
    B = rng.normal(size=(5000, d))
    cos = np.sum(A * B, axis=1) / (np.linalg.norm(A, axis=1) * np.linalg.norm(B, axis=1))
    print(f"d={d:>4}  mean={cos.mean():+.3f}  std={cos.std():.3f}  1/sqrt(d)={1/np.sqrt(d):.3f}")
# d=   3  mean=+0.00x  std=0.577  1/sqrt(d)=0.577
# d=  30  mean=+0.00x  std=0.18   1/sqrt(d)=0.183
# d= 300  mean=+0.00x  std=0.058  1/sqrt(d)=0.058
# d= 768  mean=+0.00x  std=0.036  1/sqrt(d)=0.036
# Unrelated random directions in 768-D have cosine within about +-0.04 of zero.
# A cosine of 0.3 between two real embeddings is therefore a strong signal, not a weak one.`;
