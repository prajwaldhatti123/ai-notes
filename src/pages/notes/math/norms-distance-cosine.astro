const sections = [
  { id: 'why', label: 'Why this note matters' },
  { id: 'plain', label: 'In plain words' },
  { id: 'norm', label: 'The norm: how big a vector is' },
  { id: 'other-norms', label: 'L1, L2 and L∞' },
  { id: 'distance', label: 'Distance between two vectors' },
  { id: 'cosine', label: 'Cosine similarity: direction only' },
  { id: 'which', label: 'Dot product, cosine or distance?' },
  { id: 'normalize', label: 'Normalizing: three things with one name' },
