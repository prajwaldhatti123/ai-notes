const sections = [
  { id: 'why', label: 'Why this note matters' },
  { id: 'plain', label: 'In plain words' },
  { id: 'norm', label: 'The norm: how big a vector is' },
  { id: 'other-norms', label: 'L1, L2 and L∞' },
