const sections = [
  { id: 'why', label: 'Why this note matters' },
  { id: 'plain', label: 'In plain words' },
  { id: 'functions', label: 'Functions: machines with knobs' },
  { id: 'exponents', label: 'Exponents and their rules' },
  { id: 'e', label: 'The number e' },
  { id: 'logs', label: 'Logarithms: “which power?”' },
  { id: 'log-rules', label: 'The log rules you will use' },
  { id: 'why-logs', label: 'Why machine learning loves logs' },
