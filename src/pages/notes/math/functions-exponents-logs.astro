// Small plotting helper for the figures: a panel maps math coordinates to SVG coordinates.
const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;
const curve = (p: Panel, f: (x: number) => number, from = p.xr[0], to = p.xr[1], n = 120) => {
  let d = '';
  let pen = false;
  for (let i = 0; i <= n; i++) {
    const vx = from + ((to - from) * i) / n;
    const vy = f(vx);
    if (!isFinite(vy) || vy < p.yr[0] || vy > p.yr[1]) { pen = false; continue; }
    d += `${pen ? 'L' : 'M'}${sx(p, vx).toFixed(1)} ${sy(p, vy).toFixed(1)} `;
    pen = true;
  }
  return d;
};
const axes = (p: Panel) => {
  const parts: string[] = [];
  if (p.yr[0] <= 0 && p.yr[1] >= 0) parts.push(`M${p.x} ${sy(p, 0).toFixed(1)} H${p.x + p.w}`);
  if (p.xr[0] <= 0 && p.xr[1] >= 0) parts.push(`M${sx(p, 0).toFixed(1)} ${p.y} V${p.y + p.h}`);
  return parts.join(' ');
};

// Fig. 2: growth curves.
const growth: Panel = { x: 110, y: 30, w: 500, h: 220, xr: [-3, 3], yr: [0, 8] };
// Fig. 3: the natural log.
const lnPanel: Panel = { x: 90, y: 30, w: 540, h: 230, xr: [0, 8], yr: [-5, 2.5] };
const lnDots = [
  { x: 0.01, y: M.log(0.01), label: 'ln 0.01 = −4.6' },
  { x: 0.5, y: M.log(0.5), label: 'ln 0.5 = −0.69' },
  { x: 1, y: 0, label: 'ln 1 = 0' },
  { x: M.E, y: 1, label: 'ln e = 1' },
  { x: M.E * M.E, y: 2, label: 'ln 7.39 = 2' },
];
// Fig. 4: the loss curve −ln p.
const lossPanel: Panel = { x: 110, y: 30, w: 500, h: 230, xr: [0, 1], yr: [0, 5] };
// dx, dy place each label clear of its neighbours; the two right-hand dots sit almost on top of each other.
const lossDots = [
  { p: 0.99, label: '0.01', dx: 0, dy: -62, anchor: 'end' },
  { p: 0.9, label: '0.11', dx: 0, dy: -34, anchor: 'end' },
  { p: 0.5, label: '0.69', dx: -12, dy: -14, anchor: 'end' },
  { p: 0.1, label: '2.3', dx: 12, dy: -10, anchor: 'start' },
  { p: 0.01, label: '4.6', dx: 12, dy: -10, anchor: 'start' },
];
// Fig. 5: the zoo, six small panels.
const zoo = [
  { name: 'y = 2x + 1', where: 'a neuron before activation', f: (x: number) => 2 * x + 1, yr: [-4, 6] as [number, number] },
  { name: 'y = x²', where: 'squared error', f: (x: number) => x * x, yr: [-1, 9] as [number, number] },
  { name: 'y = eˣ', where: 'softmax', f: (x: number) => M.exp(x), yr: [-1, 9] as [number, number] },
  { name: 'y = ln x', where: 'log loss, log-probs', f: (x: number) => M.log(x), yr: [-4, 2] as [number, number] },
  { name: 'y = 1 / (1 + e⁻ˣ)', where: 'sigmoid, logistic regression', f: (x: number) => 1 / (1 + M.exp(-x)), yr: [-0.2, 1.2] as [number, number] },
  { name: 'y = max(0, x)', where: 'ReLU', f: (x: number) => M.max(0, x), yr: [-1, 3] as [number, number] },
].map((z, i) => ({
  ...z,
  panel: { x: 40 + (i % 3) * 230, y: 40 + M.floor(i / 3) * 170, w: 180, h: 100, xr: [-3, 3] as [number, number], yr: z.yr },
}));

const rulesCode = `import numpy as np

a, b, n = 6.0, 1.5, 3.0

# np.log is the NATURAL log (base e). np.log2 and np.log10 are the others.
assert np.isclose(np.log(a * b), np.log(a) + np.log(b))        # product -> sum
assert np.isclose(np.log(a / b), np.log(a) - np.log(b))        # quotient -> difference
assert np.isclose(np.log(a ** n), n * np.log(a))               # power -> multiple
assert np.isclose(np.log(np.exp(2.5)), 2.5)                    # log undoes exp
assert np.isclose(np.exp(np.log(a)), a)                        # exp undoes log
assert np.isclose(np.log2(a), np.log(a) / np.log(2))           # change of base
print(np.log(1), np.log(np.e), np.log(0.5), np.log(0.01))     # 0.0 1.0 -0.693 -4.605`;

const underflowCode = `import numpy as np

# One thousand examples, each given probability 0.001 by a model.
p = np.full(1000, 0.001)

print(np.prod(p))              # 0.0  -> underflow: the true value 1e-3000 is below float64's smallest number
print(np.sum(np.log(p)))       # -6907.755...  -> the same quantity in log space, perfectly fine

# Comparing two models by likelihood is impossible in raw space and trivial in log space:
q = np.full(1000, 0.002)
print(np.prod(q) > np.prod(p))                  # False (both are 0.0!)
print(np.sum(np.log(q)) > np.sum(np.log(p)))    # True`;

const softmaxCode = `import numpy as np

def softmax_naive(z):
    e = np.exp(z)
    return e / e.sum()

def softmax(z):
    z = z - np.max(z)          # shift: the result is identical, the numbers are safe
    e = np.exp(z)
    return e / e.sum()

def log_softmax(z):
    z = z - np.max(z)
    return z - np.log(np.sum(np.exp(z)))     # log(e^z / sum) = z - log(sum)

print(softmax(np.array([2.0, 1.0, 0.0])))              # [0.665 0.245 0.090]
print(softmax_naive(np.array([1000.0, 1001.0, 1002.0])))   # [nan nan nan]  -> exp(1000) overflows
print(softmax(np.array([1000.0, 1001.0, 1002.0])))         # [0.090 0.245 0.665]
print(log_softmax(np.array([2.0, 1.0, 0.0])))          # [-0.408 -1.408 -2.408]
print(np.exp(log_softmax(np.array([2.0, 1.0, 0.0]))))  # same as softmax`;

const lossCode = `import numpy as np

def log_loss(p_correct):
    """Cross-entropy for one example: the log loss of the probability given to the right answer."""
    return -np.log(p_correct)

for p in [0.99, 0.9, 0.5, 0.1, 0.01]:
    print(f"p = {p:<5}  loss = {log_loss(p):.3f}")
# p = 0.99   loss = 0.010
# p = 0.9    loss = 0.105
# p = 0.5    loss = 0.693
# p = 0.1    loss = 2.303
# p = 0.01   loss = 4.605

# Perplexity is e to the mean loss: "the model was as unsure as if choosing among this many options".
mean_loss = 2.3
print(np.exp(mean_loss))     # 9.97 -> about 10 equally likely options`;
