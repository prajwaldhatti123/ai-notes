];

// Fig. 2: the four input corners for AND and XOR. `on` marks points whose answer is 1.
const corners = (ox: number, on: number[][]) =>
  [
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1],
  ].map(([a, b]) => ({ cx: ox + a * 120, cy: 210 - b * 120, on: on.some(([p, q]) => p === a && q === b) }));
const gates = [
  { ox: 110, name: 'AND', points: corners(110, [[1, 1]]) },
  { ox: 450, name: 'XOR', points: corners(450, [[0, 1], [1, 0]]) },
];

// Fig. 4: a 3-4-2 network. Node positions per layer, then every connection between neighbours.
const layers = [
  { x: 120, ys: [70, 150, 230], fill: 'fill-gold' },
  { x: 360, ys: [50, 117, 183, 250], fill: 'fill-green' },
  { x: 600, ys: [110, 190], fill: 'fill-blue' },
];
const edges = layers.slice(0, -1).flatMap((from, i) =>
  from.ys.flatMap((y1) => layers[i + 1].ys.map((y2) => ({ x1: from.x + 22, y1, x2: layers[i + 1].x - 22, y2 })))
);

// Fig. 3: activation curves, sampled into SVG paths. 20px per unit on x.
const M = globalThis.Math;
const erf = (x: number) => {
  const t = 1 / (1 + 0.3275911 * M.abs(x));
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * M.exp(-x * x);
  return x >= 0 ? y : -y;
};
const curve = (cx: number, cy: number, yScale: number, f: (x: number) => number) =>
  Array.from({ length: 81 }, (_, i) => {
    const x = -4 + i * 0.1;
    return `${i === 0 ? 'M' : 'L'}${(cx + x * 20).toFixed(1)} ${(cy - f(x) * yScale).toFixed(1)}`;
  }).join(' ');
const plots = [
  { cx: 120, name: 'ReLU', formula: 'max(0, z)', d: curve(120, 150, 20, (x) => M.max(0, x)) },
  { cx: 360, name: 'Sigmoid', formula: 'squashes into 0…1', d: curve(360, 150, 80, (x) => 1 / (1 + M.exp(-x))) },
  { cx: 600, name: 'GELU', formula: 'a smooth ReLU (used in GPT)', d: curve(600, 150, 20, (x) => (x * (1 + erf(x / M.SQRT2))) / 2) },
];

const numpyCode = `import numpy as np

x = np.array([1.0, 2.0, 3.0])        # three inputs
w = np.array([0.5, -1.0, 2.0])       # one weight per input
b = 0.1                              # bias

z = np.dot(w, x) + b                 # weighted sum: 0.5 - 2.0 + 6.0 + 0.1 = 4.6
a = max(0.0, z)                      # ReLU activation: 4.6
print(z, a)`;

const xorCode = `import numpy as np

X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]], dtype=float)   # all four inputs, one per row

W1 = np.array([[1, 1],      # weights of hidden neuron h1
               [1, 1]])     # weights of hidden neuron h2
b1 = np.array([0, -1])      # biases of h1 and h2
W2 = np.array([[1, -2]])    # output neuron: y = 1*h1 - 2*h2
b2 = np.array([0])

H = np.maximum(0, X @ W1.T + b1)    # hidden layer with ReLU, shape (4, 2)
Y = H @ W2.T + b2                   # output layer, shape (4, 1)
print(Y.ravel())                    # [0. 1. 1. 0.]  -> XOR`;

const torchCode = `import torch
import torch.nn as nn

model = nn.Sequential(
    nn.Linear(3, 4),   # 3 inputs -> 4 hidden neurons: 3*4 weights + 4 biases = 16
    nn.ReLU(),         # the bend; has no parameters
    nn.Linear(4, 2),   # 4 hidden -> 2 outputs:        4*2 weights + 2 biases = 10
)

x = torch.tensor([[1.0, 2.0, 3.0]])   # shape (1, 3): a batch of one example
y = model(x)                          # the forward pass
print(y.shape)                        # torch.Size([1, 2])

print(model[0].weight.shape)          # torch.Size([4, 3])  -> (out_features, in_features)
print(model[0].bias.shape)            # torch.Size([4])

print(sum(p.numel() for p in model.parameters()))   # 26`;
