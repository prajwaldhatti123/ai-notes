const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;

// Fig. 1: loss contours, elongated vs round, with gradient-descent paths.
const ell: Panel = { x: 40, y: 30, w: 300, h: 220, xr: [-3, 3], yr: [-3, 3] };
const rnd: Panel = { x: 400, y: 30, w: 300, h: 220, xr: [-3, 3], yr: [-3, 3] };
const ellipse = (p: Panel, a: number, b: number) =>
  Array.from({ length: 73 }, (_, i) => {
    const t = (i * M.PI) / 36;
    return `${i ? 'L' : 'M'}${sx(p, a * M.cos(t)).toFixed(1)} ${sy(p, b * M.sin(t)).toFixed(1)}`;
  }).join(' ') + ' Z';
// Zigzag path for the elongated bowl: step along the steep axis overshoots, slow progress along the flat axis.
const zig: [number, number][] = [[-2.6, 0.62], [-2.3, -0.54], [-2.0, 0.46], [-1.75, -0.39], [-1.5, 0.33], [-1.3, -0.27], [-1.1, 0.23], [-0.95, -0.19], [-0.8, 0.16], [-0.68, -0.13]];
const straight: [number, number][] = [[-2.6, 2.2], [-1.6, 1.35], [-0.95, 0.8], [-0.55, 0.47], [-0.3, 0.25], [-0.15, 0.12]];
const pathD = (p: Panel, pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${sx(p, a).toFixed(1)} ${sy(p, b).toFixed(1)}`).join(' ');
// Fig. 2: one column under three scalers.
const ages = [20, 30, 40, 50, 60];
const strips = [
  { label: 'raw (years)', xr: [10, 70] as [number, number], vals: ages, ticks: [20, 40, 60] },
  { label: 'standardized (z)', xr: [-2, 2] as [number, number], vals: [-1.41, -0.71, 0, 0.71, 1.41], ticks: [-1, 0, 1] },
  { label: 'min-max [0, 1]', xr: [-0.2, 1.2] as [number, number], vals: [0, 0.25, 0.5, 0.75, 1], ticks: [0, 0.5, 1] },
].map((s, i) => ({ ...s, panel: { x: 150, y: 50 + i * 80, w: 480, h: 0, xr: s.xr, yr: [0, 1] as [number, number] } }));
// Fig. 4: one-hot table.
const cities = ['London', 'Paris', 'Tokyo', 'Paris'];
const cols = ['London', 'Paris', 'Tokyo'];
// Fig. 5: skewed income before and after log.
const before = [38, 22, 13, 8, 5, 4, 3, 2, 2, 1, 1, 1];
const after = [1, 3, 7, 14, 22, 26, 20, 11, 5, 2, 1, 0];
const barsL: Panel = { x: 40, y: 30, w: 300, h: 200, xr: [0, 12], yr: [0, 40] };
const barsR: Panel = { x: 400, y: 30, w: 300, h: 200, xr: [0, 12], yr: [0, 40] };

const byHandCode = `import numpy as np

age = np.array([20., 30., 40., 50., 60.])
income = np.array([20_000., 25_000., 30_000., 35_000., 1_000_000.])   # one outlier

def standardize(x):  return (x - x.mean()) / x.std()
def minmax(x):       return (x - x.min()) / (x.max() - x.min())
def robust(x):
    q1, q3 = np.percentile(x, [25, 75])
    return (x - np.median(x)) / (q3 - q1)

np.set_printoptions(precision=2, suppress=True)
print(standardize(age))      # [-1.41 -0.71  0.    0.71  1.41]
print(minmax(age))           # [0.   0.25 0.5  0.75 1.  ]
print(robust(age))           # [-1.  -0.5  0.   0.5  1. ]

print(standardize(income))   # [-0.52 -0.51 -0.49 -0.48  2.  ]   four values squashed together by the outlier
print(minmax(income))        # [0.    0.01 0.01 0.02 1.  ]       worse
print(robust(income))        # [-1.  -0.5  0.   0.5  97. ]       the normal values keep their spread
print(np.log10(income))      # [4.3  4.4  4.48 4.54 6.  ]        the outlier is pulled in`;

const gdCode = `import numpy as np

# Two features on wildly different scales: x1 in [0, 1], x2 in [0, 1000].
rng = np.random.default_rng(0)
n = 200
X = np.column_stack([rng.uniform(0, 1, n), rng.uniform(0, 1000, n)])
y = 3 * X[:, 0] + 0.002 * X[:, 1] + rng.normal(0, 0.1, n)

def gradient_descent(X, y, lr, steps=5000):
    w = np.zeros(X.shape[1]); b = 0.0
    for _ in range(steps):
        err = X @ w + b - y
        w -= lr * 2 * X.T @ err / n
        b -= lr * 2 * err.mean()
    return np.mean((X @ w + b - y) ** 2)

Xs = (X - X.mean(axis=0)) / X.std(axis=0)         # standardize each column
for lr in [1e-6, 1e-4, 1e-2, 1e-1]:
    raw = gradient_descent(X, y, lr)
    scaled = gradient_descent(Xs, y, lr)
    print(f"lr={lr:<6}  raw MSE={raw:>12.4g}   scaled MSE={scaled:>10.4g}")
# Raw features: only a tiny learning rate avoids divergence, and then it crawls (MSE still large after 5000 steps).
# Scaled features: lr=0.1 converges to the noise floor (~0.01) in a few hundred steps.`;

const knnCode = `import numpy as np
from sklearn.datasets import load_wine
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline

X, y = load_wine(return_X_y=True)             # 13 features: alcohol (~13), magnesium (~100), proline (~750)...
Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=0.3, random_state=0, stratify=y)

raw = KNeighborsClassifier(5).fit(Xtr, ytr).score(Xte, yte)
scaled = make_pipeline(StandardScaler(), KNeighborsClassifier(5)).fit(Xtr, ytr).score(Xte, yte)
print(f"kNN accuracy  raw: {raw:.2f}   scaled: {scaled:.2f}")   # about 0.72 vs 0.96
# Unscaled, the distance is dominated by proline (values in the hundreds); the other 12 features barely count.`;

const pipelineCode = `import numpy as np, pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split

df = pd.DataFrame({
    "size":  [1.0, 1.5, 2.0, 1.2, np.nan, 2.4, 0.9, 1.8],
    "age":   [10, 5, 1, 30, 12, 2, 40, 8],
    "city":  ["London", "Paris", "Tokyo", "Paris", "London", "Tokyo", "London", "Paris"],
    "price": [200, 300, 380, 230, 260, 450, 150, 340],
})
X, y = df.drop(columns="price"), df["price"]
Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=0.25, random_state=0)

numeric = Pipeline([("impute", SimpleImputer(strategy="median")), ("scale", StandardScaler())])
categorical = OneHotEncoder(handle_unknown="ignore")                   # unseen city -> all zeros, no crash
prep = ColumnTransformer([("num", numeric, ["size", "age"]), ("cat", categorical, ["city"])])
model = Pipeline([("prep", prep), ("reg", LinearRegression())])

model.fit(Xtr, ytr)                        # every mean, std, median and category list is learned from Xtr ONLY
print(model.predict(Xte))                  # the same learned transforms are applied to Xte automatically
print(model.named_steps["prep"].get_feature_names_out())
# ['num__size' 'num__age' 'cat__city_London' 'cat__city_Paris' 'cat__city_Tokyo']`;

const leakCode = `import numpy as np
from sklearn.preprocessing import StandardScaler

rng = np.random.default_rng(0)
train = rng.normal(50, 10, size=(100, 1))
test = rng.normal(80, 10, size=(20, 1))      # the test data comes from a shifted world

# WRONG: fit the scaler on everything, then split.
scaler_all = StandardScaler().fit(np.vstack([train, test]))
# RIGHT: fit on train only.
scaler_train = StandardScaler().fit(train)

print("test mean, wrong way:", scaler_all.transform(test).mean().round(2))     # ~1.0: the shift is hidden
print("test mean, right way:", scaler_train.transform(test).mean().round(2))   # ~3.0: the shift is visible
# The wrong way lets test statistics leak into preprocessing and overstates how well you will do in production,
# where the scaler is frozen and new data is whatever it is.`;
