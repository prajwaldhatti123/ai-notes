const wiggle = (p: Panel) =>
  pts.map((pt, i) => (i === 0 ? `M${sx(p, pt.x).toFixed(1)} ${sy(p, pt.y).toFixed(1)}` : `Q${sx(p, pt.x - 0.5).toFixed(1)} ${sy(p, (pts[i - 1].y + pt.y) / 2 + (i % 2 ? 3 : -3)).toFixed(1)} ${sx(p, pt.x).toFixed(1)} ${sy(p, pt.y).toFixed(1)}`)).join(' ');
