const baselineHandCode = `import numpy as np

# the three houses from earlier
prices = np.array([200.0, 300.0, 380.0])

# The baseline ignores the sizes and guesses the same price for every house.
guess = prices.mean()                            # 293.33
baseline = np.full_like(prices, guess)           # [293.33 293.33 293.33]
baseline_mse = np.mean((baseline - prices) ** 2)
print(round(guess, 2), round(baseline_mse, 1))   # 293.33 5422.2

# The best line from earlier uses the sizes.
sizes = np.array([1.0, 1.5, 2.0])
model_mse = np.mean((180 * sizes + 23.33 - prices) ** 2)
print(round(model_mse, 1))                       # 22.2

# How much of the baseline's error did the sizes remove?
skill = 1 - model_mse / baseline_mse
print(f"{skill:.1%}")                            # 99.6%

# Why the mean? Try other constant guesses and score each one two ways.
for c in [250, prices.mean(), np.median(prices), 350]:
    mse = np.mean((c - prices) ** 2)             # mean squared error
    mae = np.mean(np.abs(c - prices))            # mean absolute error
    print(f"guess {c:6.1f}   MSE {mse:7.1f}   MAE {mae:5.1f}")
# guess  250.0   MSE  7300.0   MAE  76.7
# guess  293.3   MSE  5422.2   MAE  62.2    <- the mean wins on squared error
# guess  300.0   MSE  5466.7   MAE  60.0    <- the median wins on absolute error
# guess  350.0   MSE  8633.3   MAE  76.7`;

const baselineDiabetesCode = `import numpy as np
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, mean_absolute_error

# 442 patients, 10 measurements each; y = disease progression score (25 to 346)
X, y = load_diabetes(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=0)

# Step 1: the baselines. Each is ONE number, computed from the TRAINING
# answers only, then guessed for every one of the 89 test patients.
guesses = {"mean": y_train.mean(), "median": np.median(y_train), "zero": 0.0}
for name, value in guesses.items():
    pred = np.full_like(y_test, value)
    mse = mean_squared_error(y_test, pred)
    mae = mean_absolute_error(y_test, pred)
    print(f"{name:>6} baseline   guess {value:6.1f}   MSE {mse:6.0f}   MAE {mae:5.1f}")

# Step 2: the real model, which reads the 10 measurements.
model = LinearRegression().fit(X_train, y_train)
pred = model.predict(X_test)
model_mse = mean_squared_error(y_test, pred)
model_mae = mean_absolute_error(y_test, pred)
print(f"linear regression                MSE {model_mse:6.0f}   MAE {model_mae:5.1f}")

# Step 3: report the model against the strongest honest baseline.
baseline = np.full_like(y_test, y_train.mean())
baseline_mse = mean_squared_error(y_test, baseline)
skill = 1 - model_mse / baseline_mse
print(f"skill over the mean baseline: {skill:.0%}")

# The square root of an MSE is back in the score's own units: a typical
# miss, in points.
baseline_miss = np.sqrt(baseline_mse)
model_miss = np.sqrt(model_mse)
print(f"typical miss: baseline {baseline_miss:.0f} points, model {model_miss:.0f} points")

# Output:
#   mean baseline   guess  151.6   MSE   5135   MAE  59.2
# median baseline   guess  139.0   MSE   5360   MAE  59.0
#   zero baseline   guess    0.0   MSE  28913   MAE 154.2
# linear regression                MSE   3424   MAE  46.2
# skill over the mean baseline: 33%
# typical miss: baseline 72 points, model 59 points`;

