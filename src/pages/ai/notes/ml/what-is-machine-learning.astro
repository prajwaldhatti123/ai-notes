const bruteForceCode = `import numpy as np

# Three houses: size in thousands of square feet, price in thousands.
sizes = np.array([1.0, 1.5, 2.0])
prices = np.array([200.0, 300.0, 380.0])

def predict(w, b, x):              # the MODEL: a line with two knobs
    return w * x + b

# the LOSS: mean squared error over the data
def loss(w, b):
    errors = predict(w, b, sizes) - prices
    return np.mean(errors ** 2)

print(loss(180, 0), loss(200, 0), loss(190, 10))
# 566.666... 133.333... 41.666...   (matches the table)

# The dumbest OPTIMIZER: try every knob setting on a grid and keep the best
# one.
best_loss = None
for w in range(150, 251, 2):       # slopes 150, 152, ..., 250
    for b in range(-50, 51, 2):    # intercepts -50, -48, ..., 50
        current = loss(w, b)
        if best_loss is None or current < best_loss:
            best_loss = current
            best_w = w
            best_b = b
# -> price ~ 180 * size + 24 on this coarse grid
print(best_w, best_b, round(best_loss, 2))
# prints 180 24 22.67

# That is machine learning in miniature: data, a model with knobs, a loss,
# and a search over the knobs.
# Gradient descent (week 2) replaces the grid with a smarter search;
# everything else stays the same.`;

const sklearnCode = `import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

# scikit-learn wants 2-D: one row per house, one column per feature
sizes = np.array([[1.0], [1.5], [2.0]])
prices = np.array([200.0, 300.0, 380.0])

# the model: y = w x + b, knobs not yet set
model = LinearRegression()
# the optimizer: finds the best w and b for the data
model.fit(sizes, prices)
print(model.coef_)                # [180.]   the slope w the model learned
print(round(model.intercept_, 2))  # 23.33    the intercept b: the exact best line; the grid got close

new_house = np.array([[1.8]])     # a house of 1,800 sq ft we have not seen
# inference: the predicted price
print(model.predict(new_house).round(2))
# prints [347.33]

predictions = model.predict(sizes)
# the loss at the best knobs
print(round(mean_squared_error(prices, predictions), 2))
# prints 22.22`;

const splitCode = `import numpy as np
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

# 442 patients, 10 features, target = disease progression
X, y = load_diabetes(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=0)
# (89, 10)   rows, columns of each part
print(X_train.shape, X_test.shape)
# prints (353, 10)

# Baseline first: always predict the training mean. Any real model must beat
# this (see Baselines above).
baseline = np.full_like(y_test, y_train.mean())
baseline_mse = mean_squared_error(y_test, baseline)
print("baseline test MSE:", round(baseline_mse))     # 5135

# make the model and train it in one line
model = LinearRegression().fit(X_train, y_train)
train_mse = mean_squared_error(y_train, model.predict(X_train))
test_mse = mean_squared_error(y_test, model.predict(X_test))
print("train MSE:", round(train_mse))                # 2735
print("test  MSE:", round(test_mse))                 # 3424

# The test number is the one that matters: it estimates performance on
# patients we have never seen.
# It is a little worse than train, which is normal. If it were much worse,
# we would suspect overfitting.`;

// Fig. 6: the baseline (a flat line at the mean price) next to the best line.
const bl1: Panel = { x: 60, y: 30, w: 260, h: 220, xr: [0.5, 2.5], yr: [0, 500] };
const bl2: Panel = { x: 440, y: 30, w: 260, h: 220, xr: [0.5, 2.5], yr: [0, 500] };
