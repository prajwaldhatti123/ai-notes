const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;
const line = (p: Panel, w: number, b: number) => `M${sx(p, p.xr[0]).toFixed(1)} ${sy(p, w * p.xr[0] + b).toFixed(1)} L${sx(p, p.xr[1]).toFixed(1)} ${sy(p, w * p.xr[1] + b).toFixed(1)}`;

// Fig. 4: three houses and three candidate lines.
const houses = [
  { x: 1, y: 200 },
  { x: 1.5, y: 300 },
  { x: 2, y: 380 },
];
const fit: Panel = { x: 90, y: 30, w: 360, h: 240, xr: [0.5, 2.5], yr: [0, 500] };
const candidates = [
  { w: 180, b: 0, label: 'w = 180, b = 0: loss 567', cls: 'stroke-soft', dash: '7 5' },
  { w: 200, b: 0, label: 'w = 200, b = 0: loss 133', cls: 'stroke', dash: '' },
  { w: 190, b: 10, label: 'w = 190, b = 10: loss 42', cls: 'stroke ink-red', dash: '' },
];
// Fig. 5: memorizing versus learning.
const gen: Panel = { x: 40, y: 30, w: 300, h: 220, xr: [0, 10], yr: [0, 10] };
const gen2: Panel = { x: 400, y: 30, w: 300, h: 220, xr: [0, 10], yr: [0, 10] };
const pts = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((x) => ({ x, y: 0.8 * x + 1 + [0.9, -1.1, 0.7, -0.8, 1.2, -0.6, 0.5, -1.0, 0.8][x - 1] }));
const wiggle = (p: Panel) =>
  pts.map((pt, i) => (i === 0 ? `M${sx(p, pt.x).toFixed(1)} ${sy(p, pt.y).toFixed(1)}` : `Q${sx(p, pt.x - 0.5).toFixed(1)} ${sy(p, (pts[i - 1].y + pt.y) / 2 + (i % 2 ? 3 : -3)).toFixed(1)} ${sx(p, pt.x).toFixed(1)} ${sy(p, pt.y).toFixed(1)}`)).join(' ');
const newPoint = { x: 5.5, y: 5.6 };

const bruteForceCode = `import numpy as np

# Three houses: size in thousands of square feet, price in thousands.
sizes  = np.array([1.0, 1.5, 2.0])
prices = np.array([200.0, 300.0, 380.0])

def predict(w, b, x):            # the MODEL: a line with two knobs
    return w * x + b

def loss(w, b):                  # the LOSS: mean squared error over the data
    errors = predict(w, b, sizes) - prices
    return np.mean(errors ** 2)

print(loss(180, 0), loss(200, 0), loss(190, 10))     # 566.7 133.3 41.7  (matches the table)

# The dumbest OPTIMIZER: try a grid of knob settings and keep the best.
best = min(((loss(w, b), w, b) for w in range(150, 251, 2) for b in range(-50, 51, 2)))
print(best)                                           # (22.67, 180, 24)  -> price ~ 180 * size + 24 on this coarse grid

# That is machine learning in miniature: data, a model with knobs, a loss, and a search over the knobs.
# Gradient descent (week 2) replaces the grid with a smarter search; everything else stays the same.`;

const sklearnCode = `import numpy as np
from sklearn.linear_model import LinearRegression

sizes  = np.array([[1.0], [1.5], [2.0]])     # scikit-learn wants a 2-D array: (examples, features)
prices = np.array([200.0, 300.0, 380.0])

model = LinearRegression()        # the model: y = w x + b, knobs not yet set
model.fit(sizes, prices)          # the optimizer: finds the best w and b for the data
print(model.coef_, model.intercept_)          # [180.] 23.33  the exact best line; the grid got close
print(model.predict([[1.8]]))                 # [347.33]      inference on a house we have not seen

from sklearn.metrics import mean_squared_error
print(mean_squared_error(prices, model.predict(sizes)))     # 22.22  the loss at the best knobs`;

const splitCode = `import numpy as np
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

X, y = load_diabetes(return_X_y=True)        # 442 patients, 10 features, target = disease progression
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=0)
print(X_train.shape, X_test.shape)           # (353, 10) (89, 10)

# Baseline first: always predict the training mean. Any real model must beat this.
baseline = np.full_like(y_test, y_train.mean())
print("baseline test MSE:", mean_squared_error(y_test, baseline))      # about 5500

model = LinearRegression().fit(X_train, y_train)
print("train MSE:", mean_squared_error(y_train, model.predict(X_train)))   # about 2900
print("test  MSE:", mean_squared_error(y_test,  model.predict(X_test)))    # about 3400

# The test number is the one that matters: it estimates performance on patients we have never seen.
# It is a little worse than train, which is normal. If it were much worse, we would suspect overfitting.`;
