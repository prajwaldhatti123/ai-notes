const baselineSpamCode = `import numpy as np

# 1,000 emails, about 5% of them spam (1 = spam, 0 = not spam).
rng = np.random.default_rng(0)
# 1,000 random numbers between 0 and 1
draws = rng.random(1000)
# True for about 5% of them, then True/False -> 1/0
is_spam = (draws < 0.05).astype(int)
print(is_spam.sum(), "spam emails")                       # 45 spam emails

# The majority-class baseline: always say "not spam".
baseline = np.zeros_like(is_spam)
# True where the guess matches the truth
right = baseline == is_spam
# True counts as 1, False as 0
accuracy = np.mean(right)
# sounds great
print(f"accuracy {accuracy:.1%}")
# prints 95.5%
# & means "both true", email by email
caught = np.sum((baseline == 1) & (is_spam == 1))
# catches nothing
print("spam caught:", caught)
# prints 0

# So a spam filter with 95% accuracy may have learned nothing at all.
# On lopsided data, compare against this baseline, and use a metric
# that looks at the rare class.`;

const practice11Code = `import numpy as np
import matplotlib.pyplot as plt

sizes = np.array([1.0, 1.5, 2.0])
prices = np.array([200.0, 300.0, 380.0])

def loss(w, b):
    return np.mean((w * sizes + b - prices) ** 2)

# A finer grid: steps of 0.5 instead of 2.
ws = np.arange(150, 251, 0.5)      # 150.0, 150.5, ..., 250.0
bs = np.arange(-50, 51, 0.5)       # -50.0, -49.5, ..., 50.0
best_loss = None
for w in ws:
    for b in bs:
        current = loss(w, b)
        if best_loss is None or current < best_loss:
            best_loss = current
            best_w = w
            best_b = b
# (exact optimum: b = 23.33, MSE 22.22)
print(best_w, best_b, round(best_loss, 2))
# prints 180.0 23.5 22.25

# The loss as a function of w alone, with b held at its best value.
losses = []
for w in ws:
    losses.append(loss(w, 23.33))
plt.plot(ws, losses)
plt.xlabel("w (with b = 23.33)")
plt.ylabel("MSE")
plt.title("a bowl: one minimum, no traps")
plt.show()
# The loss of a linear model under MSE is a parabola in each parameter (a
# bowl in both).
# That is why gradient descent works so cleanly for it: roll downhill and
# you reach the bottom.`;

const practice12Code = `import numpy as np
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error

X, y = load_diabetes(return_X_y=True)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=0)

guesses = {"mean": y_train.mean(), "median": np.median(y_train), "zero": 0.0}
for name, value in guesses.items():
    # the same guess for every test patient
    baseline = np.full_like(y_test, value)
    error = mean_squared_error(y_test, baseline)
    print(f"{name:>6} baseline MSE: {error:8.0f}")

model = LinearRegression().fit(X_train, y_train)
model_mse = mean_squared_error(y_test, model.predict(X_test))
print(f"linear regression MSE: {model_mse:8.0f}")

mean_baseline = np.full_like(y_test, y_train.mean())
mean_mse = mean_squared_error(y_test, mean_baseline)
improvement = 1 - model_mse / mean_mse
print(f"improvement over mean baseline: {improvement:.0%}")
#   mean baseline MSE:     5135
# median baseline MSE:     5360
#   zero baseline MSE:    28913
# linear regression MSE:     3424
# improvement over mean baseline: 33%
# "The gap" is the distance from the baseline's error down to a perfect 0. The model closes a third of it.
# Always report the improvement over the baseline, not the raw number: raw
# MSE means nothing on its own.`;

const practice13Code = `import numpy as np

# 30 noisy points around the straight line y = 0.8 x + 1.
rng = np.random.default_rng(0)
# 30 random x values between 0 and 10, in order
x = np.sort(rng.uniform(0, 10, 30))
# random wobble, typically between -1 and +1
noise = rng.normal(0, 1, 30)
y = 0.8 * x + 1 + noise

# Every second point for training, the points in between for testing.
x_train = x[::2]
y_train = y[::2]
x_test = x[1::2]
y_test = y[1::2]
print(len(x_train), len(x_test))             # 15 15

for degree in [1, 3, 12]:
    # fit a curve of this degree to the training points
    coeffs = np.polyfit(x_train, y_train, degree)
    train_mse = np.mean((np.polyval(coeffs, x_train) - y_train) ** 2)
    test_mse = np.mean((np.polyval(coeffs, x_test) - y_test) ** 2)
    print(f"degree {degree:>2}: train MSE {train_mse:6.2f}   test MSE {test_mse:8.2f}")
# degree  1: train MSE   0.94   test MSE     0.89    the straight line fits the pattern
# degree  3: train MSE   0.62   test MSE     0.86    a gentle curve: about the same on test
# degree 12: train MSE   0.15   test MSE     4.74    hugs the training points, five times worse on test:
# it memorized the noise (Fig. 3, left panel)`;

const practice14Code = `import numpy as np

def train_val_test_split(X, train=0.7, val=0.15, seed=0):
    # The test share is whatever is left: 1 - 0.7 - 0.15 = 0.15.
    n = len(X)
    rng = np.random.default_rng(seed)
    # the row numbers 0..n-1 in a random order
    order = rng.permutation(n)
    n_train = int(n * train)
    n_val = int(n * val)
    # the first 70% of the shuffled order
    train_rows = order[:n_train]
    val_rows = order[n_train:n_train + n_val]       # the next 15%
    test_rows = order[n_train + n_val:]             # the rest
    return train_rows, val_rows, test_rows

X = np.arange(200).reshape(100, 2)      # 100 rows, 2 features
train_rows, val_rows, test_rows = train_val_test_split(X)
X_train = X[train_rows]                 # pick those rows out of X
print(len(train_rows), len(val_rows), len(test_rows), X_train.shape)
# prints 70 15 15 (70, 2)

# Self-checks: no row is in two parts, and together the parts cover every
# row.
# & on two sets keeps what they share
assert len(set(train_rows) & set(val_rows)) == 0
assert len(set(train_rows) & set(test_rows)) == 0
assert len(set(val_rows) & set(test_rows)) == 0
all_rows = np.concatenate([train_rows, val_rows, test_rows])
assert sorted(all_rows) == list(range(100))
print("all checks passed")              # all checks passed
# Shuffling before cutting matters: if the rows were sorted by label, an
# unshuffled split would be useless.`;
