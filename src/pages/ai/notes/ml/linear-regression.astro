  <QA q="15. On California housing, fit linear regression on raw features and on standardized features. Show the predictions are identical but the coefficients differ, and rank features by standardized coefficient.">
    <NewInCode items={[
      ["np.allclose(a, b)", "True when two arrays are equal up to tiny rounding differences. The right way to compare decimal results.", "numpy/isclose"],
      ["scaler.scale_", "The spread (standard deviation) of each feature that the scaler learned in fit.", "sklearn/standard-scaler"],
    ]} />
    
    <CodeBlock
      code={`import numpy as np
from sklearn.datasets import fetch_california_housing
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression

data = fetch_california_housing()
X = data.data
y = data.target

# features in their own units
raw = LinearRegression().fit(X, y)

# learns each feature's mean and spread
scaler = StandardScaler().fit(X)
X_scaled = scaler.transform(X)
standardized = LinearRegression().fit(X_scaled, y)

same = np.allclose(raw.predict(X), standardized.predict(X_scaled))
print("same predictions:", same)
# prints True: same model, only the units differ

for name, c_raw, c_std in zip(data.feature_names, raw.coef_, standardized.coef_):
    print(f"{name:>12}  raw {c_raw:+9.4f}   standardized {c_std:+.3f}")
#       MedInc  raw   +0.4367   standardized +0.830
#     HouseAge  raw   +0.0094   standardized +0.119
#    AveBedrms  raw   +0.6451   standardized +0.306    looks biggest raw, only because of units
#   Population  raw   -0.0000   standardized -0.005
#     Latitude  raw   -0.4213   standardized -0.900    biggest once units are removed
#   (AveRooms, AveOccup and Longitude omitted here)

# scaler.scale_ holds each feature's spread (standard deviation).
print(np.allclose(standardized.coef_, raw.coef_ * scaler.scale_))
# prints True: standardized = raw x spread`}
