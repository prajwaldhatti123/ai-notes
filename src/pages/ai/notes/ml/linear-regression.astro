const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;
const lineD = (p: Panel, w: number, b: number) => `M${sx(p, p.xr[0]).toFixed(1)} ${sy(p, w * p.xr[0] + b).toFixed(1)} L${sx(p, p.xr[1]).toFixed(1)} ${sy(p, w * p.xr[1] + b).toFixed(1)}`;
const curve = (p: Panel, f: (x: number) => number, n = 120) =>
  Array.from({ length: n + 1 }, (_, i) => {
    const vx = p.xr[0] + ((p.xr[1] - p.xr[0]) * i) / n;
    return `${i ? 'L' : 'M'}${sx(p, vx).toFixed(1)} ${sy(p, f(vx)).toFixed(1)}`;
  }).join(' ');

// The running example: three houses. Least-squares line: w = 180, b = 23.33, MSE = 22.22.
const houses = [
  { x: 1, y: 200 },
  { x: 1.5, y: 300 },
  { x: 2, y: 380 },
];
const W = 180;
const B = 70 / 3;
// Fig. 1: best line with residuals.
const fit: Panel = { x: 90, y: 30, w: 360, h: 240, xr: [0.5, 2.5], yr: [0, 500] };
// Fig. 2: the loss as a function of w with b fixed. L(w) = 22.22 + 2.4167 (w - 180)^2.
const bowl: Panel = { x: 90, y: 30, w: 400, h: 230, xr: [150, 210], yr: [0, 1100] };
const lossW = (w: number) => houses.reduce((s, h) => s + (w * h.x + B - h.y) ** 2, 0) / 3;
const bowlPts = [160, 170, 180, 190, 200];
// Fig. 4: residual plots.
const resL: Panel = { x: 40, y: 30, w: 300, h: 200, xr: [0, 11], yr: [-4, 4] };
const resR: Panel = { x: 400, y: 30, w: 300, h: 200, xr: [0, 11], yr: [-4, 4] };
const noise = [0.6, -0.9, 0.3, -0.4, 1.1, -0.7, 0.2, -1.0, 0.8, -0.3];
const goodRes = noise.map((e, i) => ({ x: i + 1, y: e }));
const badRes = noise.map((e, i) => ({ x: i + 1, y: ((i + 1 - 5.5) ** 2) / 6 - 1.5 + e * 0.4 }));
// Fig. 5: a curve fitted by linear regression on [x, x^2].
const poly: Panel = { x: 90, y: 30, w: 360, h: 230, xr: [0, 6], yr: [0, 20] };
const polyPts = [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5].map((x, i) => ({ x, y: 0.5 * x * x + 0.5 + [0.8, -0.6, 0.4, -0.9, 0.7, -0.3, 0.9, -0.8, 0.5, -0.4, 0.6][i] }));

const closedFormCode = `import numpy as np

x = np.array([1.0, 1.5, 2.0])          # sizes (thousand sq ft)
y = np.array([200.0, 300.0, 380.0])    # prices (thousands)

# Simple linear regression: the two formulas from the closed-form section.
w = np.sum((x - x.mean()) * (y - y.mean())) / np.sum((x - x.mean()) ** 2)
b = y.mean() - w * x.mean()
print(w, b)                            # 180.0 23.333

# The same answer from the normal equation, which also works for many
# features.
ones = np.ones_like(x)                 # [1. 1. 1.]
# the data table with a ones column: shape (3, 2)
X = np.column_stack([ones, x])
theta = np.linalg.inv(X.T @ X) @ X.T @ y
# b first, because the ones column is first
print(theta)
# prints [ 23.333 180. ]

# In practice never invert by hand; lstsq is more stable and copes with
# redundant columns.
theta2, residuals, rank, singular_values = np.linalg.lstsq(X, y, rcond=None)
print(theta2)                          # [ 23.333 180. ]  the same answer

predictions = X @ theta                # every prediction at once
mse = np.mean((predictions - y) ** 2)
# the smallest MSE any line can reach on these points
print(mse)
# prints 22.222`;

const gdCode = `import numpy as np

x = np.array([1.0, 1.5, 2.0])
y = np.array([200.0, 300.0, 380.0])
w = 200.0      # starting slope
b = 0.0        # starting intercept
lr = 0.1       # learning rate: how big each step is

for step in range(2000):
    predictions = w * x + b
    errors = predictions - y
    # slope of the loss in the w direction
    grad_w = (2 / len(x)) * np.sum(errors * x)
    # slope of the loss in the b direction
    grad_b = (2 / len(x)) * np.sum(errors)
    w = w - lr * grad_w                            # step downhill
    b = b - lr * grad_b
    if step in (0, 1, 10, 100, 1999):
        loss = np.mean((w * x + b - y) ** 2)
        print(f"step {step:>4}: w = {w:8.3f}   b = {b:8.3f}   loss = {loss:8.3f}")

# step    0: w =  197.333   b =   -1.333   loss =   74.074
# step    1: w =  196.356   b =   -1.600   loss =   66.966
# step   10: w =  194.592   b =    0.306   loss =   59.009
# step  100: w =  185.960   b =   13.928   loss =   28.359
# step 1999: w =  180.000   b =   23.333   loss =   22.222   <- the same answer as the closed form`;

const sklearnCode = `import numpy as np
from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

data = fetch_california_housing()
X = data.data            # 20,640 districts, 8 features each
y = data.target          # median house value, in units of $100,000
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=0)

model = LinearRegression()
model.fit(X_train, y_train)
predictions = model.predict(X_test)

# typical miss, in $100k
rmse = np.sqrt(mean_squared_error(y_test, predictions))
r2 = r2_score(y_test, predictions)
# test RMSE: 0.727   test R²: 0.594
print(f"test RMSE: {rmse:.3f}   test R²: {r2:.3f}")
# A typical miss of about 3,000, and the line removes about 59% of the
# "guess the average" error.`;

const coefCode = `import numpy as np
from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression

data = fetch_california_housing()
X_train, X_test, y_train, y_test = train_test_split(
    data.data, data.target, test_size=0.2, random_state=0)

# Rescale every feature to mean 0 and spread 1, using the training data
# only.
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
model = LinearRegression().fit(X_train_scaled, y_train)

# Pair each feature name with its coefficient, then sort by size, ignoring
# the sign.
pairs = list(zip(data.feature_names, model.coef_))
pairs = sorted(pairs, key=lambda pair: abs(pair[1]), reverse=True)
for name, coef in pairs:
    print(f"{name:>12}: {coef:+.3f}")

#     Latitude: -0.900
#    Longitude: -0.871
#       MedInc: +0.826     median income: the biggest effect that is not geography
#    AveBedrms: +0.290
#     AveRooms: -0.249     opposite sign to AveBedrms: the two move together (multicollinearity)
#     HouseAge: +0.117
#     AveOccup: -0.031
#   Population: -0.009
# Latitude and Longitude are large and opposite together: they describe
# location (the coast) between them.`;

const residualCode = `import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

rng = np.random.default_rng(0)
x = np.linspace(0, 10, 60)
# the true relationship is curved
y = 0.3 * x ** 2 + rng.normal(0, 1, 60)

# scikit-learn wants a table: shape (60, 1)
X = x[:, None]
model = LinearRegression().fit(X, y)         # but we fit a straight line
line = model.predict(X)
# what the line missed, point by point
residuals = y - line

fig, axes = plt.subplots(1, 2, figsize=(10, 4))
axes[0].scatter(x, y, s=12)
axes[0].plot(x, line, color="red")
axes[0].set_title("the straight-line fit")
axes[1].scatter(x, residuals, s=12)
axes[1].axhline(0, color="gray")
axes[1].set_title("residuals: a U shape means missing curvature")
plt.show()
# left end: the line is too low
print(residuals[:3].round(2))
# prints [5.24 4.47 4.75]
# middle: the line is too high
print(residuals[28:31].round(2))
# prints [-3.09 -2.44 -3.67]
# right end: too low again
print(residuals[-3:].round(2))
# prints [4.3  2.89 3.9 ]
# Positive, negative, positive: the U shape. Fix: add x**2 as a feature (the
# curves section).`;
