const M = globalThis.Math;
interface Panel { x: number; y: number; w: number; h: number; xr: [number, number]; yr: [number, number] }
const sx = (p: Panel, vx: number) => p.x + ((vx - p.xr[0]) / (p.xr[1] - p.xr[0])) * p.w;
const sy = (p: Panel, vy: number) => p.y + p.h - ((vy - p.yr[0]) / (p.yr[1] - p.yr[0])) * p.h;

// Fig. 1: loss contours, elongated vs round, with gradient-descent paths.
const ell: Panel = { x: 40, y: 30, w: 300, h: 220, xr: [-3, 3], yr: [-3, 3] };
const rnd: Panel = { x: 400, y: 30, w: 300, h: 220, xr: [-3, 3], yr: [-3, 3] };
const ellipse = (p: Panel, a: number, b: number) =>
  Array.from({ length: 73 }, (_, i) => {
    const t = (i * M.PI) / 36;
    return `${i ? 'L' : 'M'}${sx(p, a * M.cos(t)).toFixed(1)} ${sy(p, b * M.sin(t)).toFixed(1)}`;
  }).join(' ') + ' Z';
// Zigzag path for the elongated bowl: step along the steep axis overshoots, slow progress along the flat axis.
const zig: [number, number][] = [[-2.6, 0.62], [-2.3, -0.54], [-2.0, 0.46], [-1.75, -0.39], [-1.5, 0.33], [-1.3, -0.27], [-1.1, 0.23], [-0.95, -0.19], [-0.8, 0.16], [-0.68, -0.13]];
const straight: [number, number][] = [[-2.6, 2.2], [-1.6, 1.35], [-0.95, 0.8], [-0.55, 0.47], [-0.3, 0.25], [-0.15, 0.12]];
const pathD = (p: Panel, pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${sx(p, a).toFixed(1)} ${sy(p, b).toFixed(1)}`).join(' ');
// Fig. 2: one column under three scalers.
const ages = [20, 30, 40, 50, 60];
const strips = [
  { label: 'raw (years)', xr: [10, 70] as [number, number], vals: ages, ticks: [20, 40, 60] },
  { label: 'standardized (z)', xr: [-2, 2] as [number, number], vals: [-1.41, -0.71, 0, 0.71, 1.41], ticks: [-1, 0, 1] },
  { label: 'min-max [0, 1]', xr: [-0.2, 1.2] as [number, number], vals: [0, 0.25, 0.5, 0.75, 1], ticks: [0, 0.5, 1] },
].map((s, i) => ({ ...s, panel: { x: 150, y: 50 + i * 80, w: 480, h: 0, xr: s.xr, yr: [0, 1] as [number, number] } }));
// Fig. 4: one-hot table.
const cities = ['London', 'Paris', 'Tokyo', 'Paris'];
const cols = ['London', 'Paris', 'Tokyo'];
// Fig. 5: skewed income before and after log.
const before = [38, 22, 13, 8, 5, 4, 3, 2, 2, 1, 1, 1];
const after = [1, 3, 7, 14, 22, 26, 20, 11, 5, 2, 1, 0];
const barsL: Panel = { x: 40, y: 30, w: 300, h: 200, xr: [0, 12], yr: [0, 40] };
const barsR: Panel = { x: 400, y: 30, w: 300, h: 200, xr: [0, 12], yr: [0, 40] };

const byHandCode = `import numpy as np

age = np.array([20.0, 30.0, 40.0, 50.0, 60.0])
# one outlier
income = np.array([20_000.0, 25_000.0, 30_000.0, 35_000.0, 1_000_000.0])

def standardize(x):
    # subtract the average, divide by the spread
    return (x - x.mean()) / x.std()

def minmax(x):
    # smallest value -> 0, largest -> 1
    return (x - x.min()) / (x.max() - x.min())

def robust(x):
    # a quarter of the values are below q1
    q1 = np.percentile(x, 25)
    # three quarters are below q3
    q3 = np.percentile(x, 75)
    # centre on the middle value, divide by the middle half's width
    return (x - np.median(x)) / (q3 - q1)

# print 2 decimals, never 1e+05 style
np.set_printoptions(precision=2, suppress=True)

print(standardize(age))
print(minmax(age))
print(robust(age))

# the four normal incomes are squashed together by the outlier
print(standardize(income))
print(minmax(income))        # even worse
print(robust(income))        # the normal incomes keep their spread
# the log pulls the outlier in: 1,000,000 becomes 6
print(np.log10(income))

# Output:
# [-1.41 -0.71  0.    0.71  1.41]
# [0.   0.25 0.5  0.75 1.  ]
# [-1.  -0.5  0.   0.5  1. ]
# [-0.52 -0.51 -0.49 -0.48  2.  ]
# [0.   0.01 0.01 0.02 1.  ]
# [-1.  -0.5  0.   0.5 97. ]
# [4.3  4.4  4.48 4.54 6.  ]`;

const gdCode = `import numpy as np

# random numbers that come out the same every run
rng = np.random.default_rng(0)
n = 200
# feature 1: values between 0 and 1
x1 = rng.uniform(0, 1, n)
# feature 2: values between 0 and 1000
x2 = rng.uniform(0, 1000, n)
# a table with 200 rows and 2 columns
X = np.column_stack([x1, x2])
noise = rng.normal(0, 0.1, n)             # small random wobble
# the true rule the model has to find
y = 3 * x1 + 0.002 * x2 + noise

def train_and_score(X, y, learning_rate, steps=5000):
    # one weight per feature, starting at 0
    w = np.zeros(X.shape[1])
    b = 0.0
    for step in range(steps):
        # prediction minus truth, for every row
        error = X @ w + b - y
        # move each weight a little downhill
        w = w - learning_rate * 2 * X.T @ error / n
        # move the bias a little downhill
        b = b - learning_rate * 2 * error.mean()
    final_error = X @ w + b - y
    # the mean squared error after training
    return np.mean(final_error ** 2)

# standardize each column separately
X_scaled = (X - X.mean(axis=0)) / X.std(axis=0)

# hide the overflow warnings when a run blows up
with np.errstate(all="ignore"):
    for learning_rate in [0.000001, 0.0001, 0.01, 0.1]:
        raw = train_and_score(X, y, learning_rate)
        scaled = train_and_score(X_scaled, y, learning_rate)
        print(f"step size {learning_rate:<9}  raw MSE {raw:>10.4f}   scaled MSE {scaled:>8.4f}")

# Output:
# step size 1e-06      raw MSE     1.4845   scaled MSE   8.0557
# step size 0.0001     raw MSE        nan   scaled MSE   1.1347
# step size 0.01       raw MSE        nan   scaled MSE   0.0098
# step size 0.1        raw MSE        nan   scaled MSE   0.0098
# Raw features: only the tiniest step size avoids blowing up (nan), and then
# training crawls.
# Scaled features: step size 0.01 or 0.1 reaches the noise level (about
# 0.01).`;

const knnCode = `from sklearn.datasets import load_wine
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline

# 178 wines, 13 measurements each, y = which of 3 growers
X, y = load_wine(return_X_y=True)
# column 0: around 10 to 15
print("largest alcohol value:", X[:, 0].max())
# column 12: in the hundreds and thousands
print("largest proline value:", X[:, 12].max())

X_train, X_test, y_train, y_test = train_test_split(
    # stratify: keep the same mix of growers in both parts
    X, y, test_size=0.3, random_state=0, stratify=y)

# vote among the 5 closest training wines
raw_model = KNeighborsClassifier(n_neighbors=5)
raw_model.fit(X_train, y_train)
# fraction of test wines it gets right
raw_accuracy = raw_model.score(X_test, y_test)

scaled_model = make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=5))
# learns the scaling from X_train, then stores the scaled wines
scaled_model.fit(X_train, y_train)
# scales X_test the same way, then votes
scaled_accuracy = scaled_model.score(X_test, y_test)

print("accuracy without scaling:", round(raw_accuracy, 2))
print("accuracy with scaling:   ", round(scaled_accuracy, 2))

# Output:
# largest alcohol value: 14.83
# largest proline value: 1680.0
# accuracy without scaling: 0.72
# accuracy with scaling:    0.96
# Unscaled, distances are decided almost entirely by proline; the other 12
# measurements barely count.`;

const pipelineCode = `import numpy as np
import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split

# A small table of houses. np.nan marks a size that is missing.
houses = pd.DataFrame({
    "size":  [1.0, 1.5, 2.0, 1.2, np.nan, 2.4, 0.9, 1.8],
    "age":   [10, 5, 1, 30, 12, 2, 40, 8],
    "city":  ["London", "Paris", "Tokyo", "Paris", "London", "Tokyo", "London", "Paris"],
    "price": [200, 300, 380, 230, 260, 450, 150, 340],
})
X = houses[["size", "age", "city"]]      # the three feature columns
y = houses["price"]                      # the answer column
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=0)

# Number columns: fill gaps with the training median, then standardize.
number_steps = Pipeline([
    ("fill_gaps", SimpleImputer(strategy="median")),
    ("scale", StandardScaler()),
])
# The city column: one 0/1 column per city. A city never seen in training
# becomes all zeros.
city_step = OneHotEncoder(handle_unknown="ignore")

# Send each group of columns to its own steps, then put the results side by
# side.
prepare = ColumnTransformer([
    ("num", number_steps, ["size", "age"]),
    ("cat", city_step, ["city"]),
])
model = Pipeline([
    ("prepare", prepare),
    ("line", LinearRegression()),
])

# every median, mean, spread and city list is learned from X_train only
model.fit(X_train, y_train)
# the same learned numbers are applied to X_test, then the line predicts
predictions = model.predict(X_test)
print(predictions.round(1))
# the columns the line actually sees
print(model.named_steps["prepare"].get_feature_names_out())

# Output:
# [146.2 398.8]
# ['num__size' 'num__age' 'cat__city_London' 'cat__city_Paris'
#  'cat__city_Tokyo']`;

const leakCode = `import numpy as np
from sklearn.preprocessing import StandardScaler

rng = np.random.default_rng(0)
# 100 rows, 1 column, centred on 50
train = rng.normal(50, 10, size=(100, 1))
# the test data comes from a shifted world: centred on 80
test = rng.normal(80, 10, size=(20, 1))
# train and test stacked into one table
everything = np.vstack([train, test])

wrong_scaler = StandardScaler()
# WRONG: learns its mean and spread from the test rows too
wrong_scaler.fit(everything)
right_scaler = StandardScaler()
# RIGHT: learns from the training rows only
right_scaler.fit(train)

wrong_mean = wrong_scaler.transform(test).mean()
right_mean = right_scaler.transform(test).mean()
print("average scaled test value, wrong way:", round(wrong_mean, 2))
print("average scaled test value, right way:", round(right_mean, 2))

# Output:
# average scaled test value, wrong way: 1.7
# average scaled test value, right way: 3.12
# The wrong way hides most of the shift (1.7 instead of about 3), so the
# test data looks more
# familiar than it is. In production the scaler is frozen, and the shift
# hits you in full.`;
