];

const basicsCode = `import numpy as np

x = np.array([3.0, 2.0])          # a vector: a 1-D array
print(x.shape)                    # (2,)  one number in the shape: one axis
print(x.ndim)                     # 1     the number of axes

u = np.array([2.0, 1.0])
v = np.array([1.0, 3.0])
print(u + v)                      # [3. 4.]  component by component
print(2 * v)                      # [2. 6.]  every component doubled
print(3 * u - v)                  # [5. 0.]  a linear combination

w = np.array([3.0, -2.0, -4.0])        # the walk score's weights
inputs = np.array([1.0, 0.0, 1.0])     # sunny, not cold, tired
# * pairs up components: still a vector
products = w * inputs
print(products)                        # [ 3. -0. -4.]
# add the products up: that is the dot product
print(np.sum(products))
# prints -1.0
print(np.dot(w, inputs))               # -1.0  the built-in function
# the same thing, written with @
print(w @ inputs)
# prints -1.0`;

const dotCode = `import numpy as np

def dot(a, b):
    """The definition, spelled out: multiply matching components, add them up."""
    total = 0.0
    for i in range(len(a)):
        total += a[i] * b[i]
    return total

a = np.array([3.0, 4.0])
b = np.array([4.0, 3.0])
print(dot(a, b))       # 24.0  by hand
print(np.dot(a, b))    # 24.0  NumPy's function
print(a @ b)           # 24.0  NumPy's operator

# the length is the square root of the self dot product
length_a = np.sqrt(a @ a)
length_b = np.linalg.norm(b)           # the library way to get a length
print(length_a, length_b)              # 5.0 5.0

cos_theta = (a @ b) / (length_a * length_b)
# the cosine of the angle between a and b
print(cos_theta)
# prints 0.96
angle = np.degrees(np.arccos(cos_theta))
print(round(angle, 2))                 # 16.26  the angle itself, in degrees

# the shadow (projection) of a on the direction of b
shadow = (a @ b) / length_b
print(shadow)                          # 4.8`;

const embedCode = `import numpy as np

# Toy "embeddings": one vector per word.
# Real ones have hundreds of numbers; the arithmetic is identical.
emb = {
    "cat": np.array([0.9, 0.8, 0.1]),
    "dog": np.array([0.8, 0.9, 0.2]),
    "car": np.array([0.1, 0.2, 0.9]),
}

def similarity(word1, word2):
    return emb[word1] @ emb[word2]

print(round(similarity("cat", "dog"), 3))   # 1.46  high: the lists agree
# low: where one is big the other is small
print(round(similarity("cat", "car"), 3))
# prints 0.34

# Find the word nearest to a query vector: score every word, keep the best.
query = np.array([0.85, 0.85, 0.15])
best_word = None
best_score = None
for word in emb:
    score = emb[word] @ query
    print(word, round(score, 3))      # cat 1.46, dog 1.475, car 0.39
    if best_score is None or score > best_score:
        best_word = word
        best_score = score
print("nearest:", best_word)          # nearest: dog`;

const matrixPreviewCode = `import numpy as np

# Two rows of weights, one row per score. A list of lists makes a 2-D array
# (a table).
W = np.array([[3.0, -2.0, -4.0],     # score 1: "should I walk?"
              [1.0, -1.0,  0.0]])    # score 2: "is the weather good?"
x = np.array([1.0, 0.0, 1.0])        # sunny, not cold, tired

# each row dotted with x: two scores in one operation
print(W @ x)
# prints [-1.  1.]
print(W.shape)        # (2, 3)   2 rows, 3 columns
print(x.shape)        # (3,)     3 numbers
print((W @ x).shape)  # (2,)     2 numbers: one score per row`;
