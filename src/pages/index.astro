---
// The library: every notebook on the site. Each notebook lives under its own path (/ai/, …).
import Base from '../layouts/Base.astro';
import { notebooks } from '../data/notebooks';
---

<Base title="Notes" description="Study notes, one notebook per subject, each explained simply first and then precisely." library>
  <div class="prose">
    <p class="eyebrow">Library · {notebooks.length} notebooks</p>
    <h1>Notes</h1>
    <p class="lede">One notebook per subject. Pick one to open it.</p>

    <ul class="shelf">
      {
        notebooks.map((nb) => (
          <li>
            {nb.href ? (
              <a class="notebook" href={nb.href} style={`--spine: ${nb.spine}`}>
                <h2>{nb.title}</h2>
                <p>{nb.blurb}</p>
                <span class="notebook-meta">{nb.meta}</span>
              </a>
            ) : (
              <div class="notebook soon" style={`--spine: ${nb.spine}`}>
                <h2>{nb.title}</h2>
                <p>{nb.blurb}</p>
                <span class="notebook-meta">{nb.meta}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>
